<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <!-- Admin package testsuites. -->
        <testsuite name="Admin Feature Test">
            <directory suffix="Test.php">packages/Webkul/Admin/tests/Feature</directory>
        </testsuite>

        <!-- Core package testsuites. -->
        <testsuite name="Core Unit Test">
            <directory suffix="Test.php">packages/Webkul/Core/tests/Unit</directory>
        </testsuite>

        <!-- DataGrid package testsuites. -->
        <testsuite name="DataGrid Unit Test">
            <directory suffix="Test.php">packages/Webkul/DataGrid/tests/Unit</directory>
        </testsuite>

        <!-- Shop package testsuites. -->
        <testsuite name="Shop Feature Test">
            <directory suffix="Test.php">packages/Webkul/Shop/tests/Feature</directory>
        </testsuite>

        <!-- Shop 纯单元测试(无容器/无数据库)。见 tests/Unit/Pest.php 的说明:
             这些测试要脱离 Laravel 跑,所以必须显式绑回 PHPUnit\Framework\TestCase。 -->
        <testsuite name="Shop Unit Test">
            <directory suffix="Test.php">packages/Webkul/Shop/tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>

            <directory>packages</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="ECOSYSTEM_EVENT_PUBLIC_ENABLED" value="false"/>
        <env name="ECOSYSTEM_CONTENT_PUBLIC_ENABLED" value="false"/>
        <env name="ECOSYSTEM_EVENT_PUBLISH_ENABLED" value="false"/>
        <env name="ECOSYSTEM_CONTENT_PUBLISH_ENABLED" value="false"/>
        <env name="ECOSYSTEM_SCHEDULER_ENABLED" value="false"/>
        <env name="ECOSYSTEM_OUTBOX_WORKER_ENABLED" value="false"/>
        <env name="ECOSYSTEM_PUBLIC_READ_EMERGENCY_DISABLED" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
