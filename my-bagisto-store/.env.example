APP_NAME=Bagisto
APP_ENV=local
APP_KEY=
# ⚠ 生产必须 false。true 时任何 500（含健康检查 /up）都会返回带堆栈的调试页。
APP_DEBUG=true
APP_DEBUG_ALLOWED_IPS=
APP_URL=http://localhost
APP_ADMIN_URL=admin
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# ==================== 队列 ====================
# ⚠ 这两项此前写成 sync/file，与实际运行的 .env（database/database）**漂移** ——
#   模板说"不用管"，实际系统依赖 out-of-band 的队列消费（下发状态机、通知、部署任务）。
#   现在对齐成实际值，避免"照模板部署完发现任务不跑"。
#
# queue= sync 时任务在**请求内同步执行**：功能上能跑通，但语义完全不同
#   （一个 HTTP 请求要把下发/通知的活干完，超时与重复执行的风险都在）。
#   本地开发图省事可以临时改 sync；**任何要对外服务的环境都必须是 database（或 redis）+ 起 worker**：
#     php artisan queue:work --tries=3
#
# ⚠ 没起 worker 是**静默失败**：任务躺在 jobs 表里没人消费，页面不报错。
#   平台对此有告警（ops:alert-queue-backlog，看「平台告警」页），但那也依赖调度器在跑。
QUEUE_CONNECTION=database

# ==================== 缓存 ====================
# database = 用 cache 表（迁移已建）；本地也可改 file。
# ⚠ 缓存与队列**共用 CACHE_STORE 之外的调度器**：ops:* 定时任务同样需要
#   `php artisan schedule:work`（或 crontab 的 schedule:run）常驻，否则不执行。
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESPONSE_CACHE_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME=Shop

ADMIN_MAIL_ADDRESS=admin@example.com
ADMIN_MAIL_NAME=Admin

CONTACT_MAIL_ADDRESS=
CONTACT_MAIL_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost
VITE_PORT=

# 小召·召唤引擎 v2(Coze Agent)—— AI 版 /api/summon-ai 使用;缺失时自动降级 rule-v1
# (补录:这四个键此前只存在于本地 .env,漏在了本示例文件之外)
COZE_BASE_URL=http://localhost:8888
COZE_PAT=
COZE_BOT_ID=

SUMMON_AI_ENABLED=false

# 调试栏(barryvdh/laravel-debugbar)。本机 .env 里是 false —— 按原样补齐,免得
# "本地开着调试栏、别人拉下来配置不一致"这种查不出原因的差异。
# 生产必须 false:它会输出 SQL、变量、会话内容。
DEBUGBAR_ENABLED=false

# 语音识别(ASR)—— POST /api/asr,腾讯云「一句话识别」
# 密钥留空 = 未配置,接口返回 code=ASR_NOT_CONFIGURED 并让前端提示「配置中」,不会报错。
# 申请地址: https://console.cloud.tencent.com/cam/capi
ASR_ENABLED=true
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-guangzhou
ASR_ENGINE=16k_zh

# 开发期置 true:把上传的音频留档到 storage/app/public/asr/,
# 便于用 ffprobe 验证前端录出来的格式(16000Hz/mono/pcm_s16le)。上线前改回 false。
ASR_KEEP_AUDIO=false

# ffmpeg:只有腾讯不收的容器(webm/mp4)才用得到,见 AudioNormalizer
# 留空或找不到时这类音频会被 422 拒绝,其余格式不受影响
ASR_FFMPEG_PATH=ffmpeg
ASR_TRANSCODE_TIMEOUT=15

# 语音合成(TTS)—— POST /api/tts,腾讯云「语音合成(基础版)」
# ⚠ 与「一句话识别」是两个独立服务:要分别开通,**资源包也各自独立**。
#   用尽时腾讯返回 UnsupportedOperation.PkgExhausted,接口降级为 TTS_FAILED(前端静默跳过)。
TTS_ENABLED=true
# 音色 ID:留空 = 用服务端默认音色。要指定音色**必须到控制台「语音合成 → 音色列表」复制真实 ID**,
# 不要照抄网上示例值——接口只做范围校验,填不存在的 ID 也能通过校验,失败要到合成时才暴露。
TTS_VOICE_TYPE=
TTS_CODEC=mp3
TTS_SAMPLE_RATE=16000
TTS_SPEED=0
TTS_VOLUME=0
TTS_MAX_CHARS=150
TTS_MAX_TOTAL_CHARS=2000
TTS_TIMEOUT=20

# ===== 语音合成 provider:tencent | volcano =====
# volcano = 火山引擎「语音合成大模型」(豆包同源),韵律和情感好得多,是当前的选择。
# ⚠ 请求形态已按控制台真实示例对齐;仍未核实的只有**响应**形态(探针会自己暴露)。
TTS_PROVIDER=volcano

# 火山引擎:控制台的 API Key —— 走 x-api-key 头(不是 Authorization: Bearer)
TTS_VOLCANO_API_KEY=
# 接口地址(大模型语音合成的 v3 单向流式端点)
TTS_VOLCANO_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# 资源 ID —— 大模型语音合成必需
TTS_VOLCANO_RESOURCE_ID=volc.service_type.10029
# 音色 ID —— **"活人感"的关键**:ID 里带 _emo_ 的是情感音色。
# 必须从控制台音色列表取;下面这个是控制台示例里的男声(北京小爷),想要女声就换掉。
TTS_VOLCANO_SPEAKER=zh_male_beijingxiaoye_emo_v2_mars_bigtts
TTS_VOLCANO_FORMAT=mp3
TTS_VOLCANO_SAMPLE_RATE=24000
# 语速:0=原速,每 +10 约快 9%。实测 10→+9% / 15→+14% / 20→+17% / 30→+23%
TTS_VOLCANO_SPEECH_RATE=15
# 响应里承载音频的字段名;待确认,探针显示是别的名字就改这里
TTS_VOLCANO_AUDIO_FIELD=data
# (可选)透传到 req_params 的额外字段,填 JSON,可覆盖任何一项:
# TTS_VOLCANO_EXTRA_REQ_PARAMS={"speed_ratio":1.1}

# 是否裁掉合成音频首尾的静音。
# ⚠ 引擎给每段都垫了约 0.2 秒留白,而朗读按句分段播 —— 相邻两段会叠成约 0.4 秒死寂,
#   听起来就是"念一句停一下"。句中停顿(逗号)会保留,那不是 padding。
TTS_TRIM_SILENCE=true
# 裁剪用的 ffmpeg(找不到就自动跳过裁剪,朗读照常)
TTS_FFMPEG_PATH=ffmpeg

# ==================== 技能包存储(对象存储) ====================
# 技能包落哪个盘。默认 private(本地 storage/app/private)。
# 切对象存储 = 改这一行 + 跑 `php artisan skill:move-assets --from=private --to=cos`。
# ⚠ 无论哪个盘都必须是**私读**的 —— 技能包不能有公开 URL,下载一律走鉴权接口。
SKILL_ASSET_DISK=private

# 单文件上传上限(KB)。⚠ 必须 ≤ PHP 的 upload_max_filesize(本机 20M),
# 否则超限文件在进校验前就被 PHP 丢弃,而接口却宣称允许更大的包。
SKILL_MAX_ASSET_KB=20480

# 上传通道内部密钥(skill-admin / skill-supply 路由组用,X-Internal-Key)
SKILL_UPLOAD_KEY=

# --- 内容安全(L0 机审的内容关键字层) ---
# 驱动:local(本地词表,可用) / wechat(微信 msgSecCheck,**留位未实现**)
CONTENT_SAFETY_DRIVER=local
# 词表路径。默认用仓库附带的那份(packages/Webkul/Shop/src/Resources/data/forbidden-words.txt)
# ⚠ 那份是**种子表**,上线前须由合规方补全
# CONTENT_SAFETY_WORDS_PATH=
# 词表缺失时:fail(默认,拒绝提审) / pass(放行但在 notes 里记录"未扫描")
# 默认 fail-closed —— "没查"不等于"合规"
CONTENT_SAFETY_ON_MISSING=fail

# 设备侧 Agent 接入的共享密钥(未配置则 /api/agent/* 整组 503)
AGENT_KEY=

# --- 平台密钥材料(签名密钥对 + 设备 CA)的存放位置 —— S-6 ---
# 默认 = local 盘(根 = storage/app)下的 keys/ 目录,与旧硬编码一致。
# ⚠ 生产必须指向**受限的持久卷**(私有挂载、不随重新部署漂移):
#   重新部署/换机丢掉这两个文件,库里没有任何可恢复副本。
# ⚠ 丢失后果:
#   · 签名私钥丢 → 所有已部署 Agent 验签失败(ERR_SIG_INVALID),下发改装全停,直到重新 enroll/重装;
#   · CA 私钥丢   → 已登记设备的证书全部链不上(证书签名鉴权 401);bearer secret 路径不受影响。
# ⚠ 上线后第一件事:php artisan agent:keys:export --to=<安全目录>,并异地/密码管理器留存。
# ⚠ 本卡没有 KMS:做的是「持久卷 + 备份/恢复命令 + 后果说明」。
# AGENT_KEYS_DISK=local
# AGENT_KEYS_DIR=keys

# --- 腾讯云 COS(仅当 SKILL_ASSET_DISK=cos 时需要) ---
# 为什么是 COS 而不是 S3:S3 驱动依赖 aws/aws-sdk-php,被本项目 composer 安全策略拦下。
COS_APP_ID=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
# 对象键前缀(可选),例如 zhaohuan/skills —— 多环境共用一个 bucket 时用得上
COS_PREFIX=
COS_USE_HTTPS=true

