            template: '#v-image-search-template',\n
\n
            data() {\n
                return {\n
                    uploadedImageUrl: '',\n
\n
                    isSearching: false,\n
                };\n
            },\n
\n
            methods: {\n
                /**\n
                 * This method will dynamically load the scripts. Because image search library\n
                 * only used when someone clicks or interact with the image button. This will\n
                 * reduce some data usage for mobile user.\n
                 * \n
                 * @return {void}\n
                 */\n
                loadLibrary() {\n
                    this.$shop.loadDynamicScript(\n
                        'https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@latest/dist/tf.min.js', () => {\n
                            this.$shop.loadDynamicScript(\n
                                'https://cdn.jsdelivr.net/npm/tensorflow-models-mobilenet-patch@2.1.1/dist/mobilenet.min.js', () => {\n
                                    this.analyzeImage();\n
                                }\n
                            );\n
                        }\n
                    );\n
                },\n
\n
                /**\n
                 * This method will analyze the image and load the sets on the bases of trained model.\n
                 * \n
                 * @return {void}\n
                 */\n
                analyzeImage() {\n
                    this.isSearching = true;\n
\n
                    let imageInput = this.$refs.imageSearchInput;\n
\n
                    if (imageInput.files && imageInput.files[0]) {\n
                        if (imageInput.files[0].type.includes('image/')) {\n
                            if (imageInput.files[0].size  {\n
                                        let net;\n
\n
                                        let self = this;\n
\n
                                        this.uploadedImageUrl = response.data;\n
\n
                                        async function app() {\n
                                            let analysedResult = [];\n
\n
                                            let queryString = '';\n
\n
                                            net = await mobilenet.load();\n
\n
                                            try {\n
                                                const result = await net.classify(document.getElementById('uploaded-image-url'));\n
\n
                                                result.forEach(function(value) {\n
                                                    queryString = value.className.split(',');\n
\n
                                                    if (queryString.length > 1) {\n
                                                        analysedResult = analysedResult.concat(queryString);\n
                                                    } else {\n
                                                        analysedResult.push(queryString[0]);\n
                                                    }\n
                                                });\n
                                            } catch (error) {\n
                                                this.$emitter.emit('add-flash', { type: 'error', message: "鍑轰簡鐐归棶棰橈紝璇风◢鍚庨噸璇曘€?});\n
                                            }\n
\n
                                            localStorage.searchedImageUrl = self.uploadedImageUrl;\n
\n
                                            queryString = localStorage.searchedTerms = analysedResult.join('_');\n
\n
                                            queryString = localStorage.searchedTerms.split('_').map(term => {\n
                                                return term.split(' ').join('+');\n
                                            });\n
\n
                                            window.location.href = `${'http://localhost/search'}?query=${queryString[0]}&image-search=1`;\n
                                        }\n
\n
                                        app();\n
                                    })\n
                                    .catch((error) => {\n
                                        this.$emitter.emit('add-flash', { type: 'error', message: "鍑轰簡鐐归棶棰橈紝璇风◢鍚庨噸璇曘€?});\n
\n
                                        this.isSearching = false;\n
                                    });\n
                            } else {\n
                                imageInput.value = '';\n
\n
                                this.$emitter.emit('add-flash', { type: 'error', message: '澶у皬闄愬埗閿欒'});\n
\n
                                this.isSearching = false;\n
                            }\n
                        } else {\n
                            imageInput.value = '';\n
\n
