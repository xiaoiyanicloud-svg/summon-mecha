        app.component('v-product-card', {\n
            template: '#v-product-card-template',\n
\n
            props: ['mode', 'product'],\n
\n
            data() {\n
                return {\n
                    isCustomer: '',\n
\n
                    isAddingToCart: false,\n
                }\n
            },\n
\n
            methods: {\n
                addToWishlist() {\n
                    if (this.isCustomer) {\n
                        this.$axios.post(`http://localhost/api/customer/wishlist`, {\n
                                product_id: this.product.id\n
                            })\n
                            .then(response => {\n
                                this.product.is_wishlist = ! this.product.is_wishlist;\n
\n
                                this.$emitter.emit('add-flash', { type: 'success', message: response.data.data.message });\n
                            })\n
                            .catch(error => {});\n
                        } else {\n
                            window.location.href = "http://localhost/customer/login";\n
                        }\n
                },\n
\n
                addToCompare(productId) {\n
                    /**\n
                     * This will handle for customers.\n
                     */\n
                    if (this.isCustomer) {\n
                        this.$axios.post('http://localhost/api/compare-items', {\n
                                'product_id': productId\n
                            })\n
                            .then(response => {\n
                                this.$emitter.emit('add-flash', { type: 'success', message: response.data.data.message });\n
                            })\n
                            .catch(error => {\n
                                if ([400, 422].includes(error.response.status)) {\n
                                    this.$emitter.emit('add-flash', { type: 'warning', message: error.response.data.data.message });\n
\n
                                    return;\n
                                }\n
\n
                                this.$emitter.emit('add-flash', { type: 'error', message: error.response.data.message});\n
                            });\n
\n
                        return;\n
                    }\n
\n
                    /**\n
                     * This will handle for guests.\n
                     */\n
                    let items = this.getStorageValue() ?? [];\n
\n
                    if (items.length) {\n
                        if (! items.includes(productId)) {\n
                            items.push(productId);\n
\n
                            localStorage.setItem('compare_items', JSON.stringify(items));\n
\n
                            this.$emitter.emit('add-flash', { type: 'success', message: "鍟嗗搧宸叉垚鍔熸坊鍔犲埌姣旇緝鍒楄〃銆? });\n
                        } else {\n
                            this.$emitter.emit('add-flash', { type: 'warning', message: "鍟嗗搧宸茬粡鍦ㄦ瘮杈冨垪琛ㄤ腑銆? });\n
                        }\n
                    } else {\n
                        localStorage.setItem('compare_items', JSON.stringify([productId]));\n
\n
                        this.$emitter.emit('add-flash', { type: 'success', message: "鍟嗗搧宸叉垚鍔熸坊鍔犲埌姣旇緝鍒楄〃銆? });\n
\n
                    }\n
                },\n
\n
                getStorageValue(key) {\n
                    let value = localStorage.getItem('compare_items');\n
\n
                    if (! value) {\n
                        return [];\n
                    }\n
\n
                    return JSON.parse(value);\n
                },\n
\n
                addToCart() {\n
                    this.isAddingToCart = true;\n
\n
                    this.$axios.post('http://localhost/api/checkout/cart', {\n
                            'quantity': 1,\n
                            'product_id': this.product.id,\n
                        })\n
                        .then(response => {\n
                            if (response.data.message) {\n
                                this.$emitter.emit('update-mini-cart', response.data.data );\n
\n
                                this.$emitter.emit('add-flash', { type: 'success', message: response.data.message });\n
                            } else {\n
                                this.$emitter.emit('add-flash', { type: 'warning', message: response.data.data.message });\n
                            }\n
\n
                            this.isAddingToCart = false;\n
                        })\n
                        .catch(error => {\n
                            this.$emitter.emit('add-flash', { type: 'error', message: error.response.data.message });\n
\n
                            if (error.response.data.redirect_uri) {\n
                                window.location.href = error.response.data.redirect_uri;\n
                            }\n
\n
                            this.isAddingToCart = false;\n
                        });\n
                },\n
            },\n
        });\n
