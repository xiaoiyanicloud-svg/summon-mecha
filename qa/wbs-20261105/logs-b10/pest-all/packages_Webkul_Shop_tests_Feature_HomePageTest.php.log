\n
            mounted() {\n
                if (!this.cart) {\n
                    this.getCart();\n
                }\n
\n
                /**\n
                 * Action.\n
                 */\n
                this.$emitter.on('update-mini-cart', (cart) => {\n
                    this.cart = cart;\n
                });\n
            },\n
\n
            methods: {\n
                getCart() {\n
                    this.$axios.get('http://localhost/api/checkout/cart')\n
                        .then(response => {\n
                            this.cart = response.data.data;\n
                        })\n
                        .catch(error => {});\n
                },\n
\n
                updateItem(quantity, item) {\n
                    this.isLoading = true;\n
\n
                    let qty = {};\n
\n
                    qty[item.id] = quantity;\n
\n
                    this.$axios.put('http://localhost/api/checkout/cart', { qty })\n
                        .then(response => {\n
                            if (response.data.message) {\n
                                this.cart = response.data.data;\n
                            } else {\n
                                this.$emitter.emit('add-flash', { type: 'warning', message: response.data.data.message });\n
                            }\n
\n
                            this.isLoading = false;\n
                        }).catch(error => this.isLoading = false);\n
                },\n
\n
                removeItem(itemId) {\n
                    this.$emitter.emit('open-confirm-modal', {\n
                        agree: () => {\n
                            this.isLoading = true;\n
\n
                            this.$axios.post('http://localhost/api/checkout/cart', {\n
                                '_method': 'DELETE',\n
                                'cart_item_id': itemId,\n
                            })\n
                            .then(response => {\n
                                this.cart = response.data.data;\n
\n
                                this.$emitter.emit('add-flash', { type: 'success', message: response.data.message });\n
\n
                                this.isLoading = false;\n
                            })\n
                            .catch(error => {\n
                                this.$emitter.emit('add-flash', { type: 'error', message: response.data.message });\n
\n
                                this.isLoading = false;\n
                            });\n
                        }\n
                    });\n
                },\n
            },\n
        });\n
