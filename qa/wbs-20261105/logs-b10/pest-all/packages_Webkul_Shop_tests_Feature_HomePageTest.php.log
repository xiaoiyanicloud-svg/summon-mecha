        app.component("v-mini-cart", {\n
            template: '#v-mini-cart-template',\n
\n
            data() {\n
                return  {\n
                    cart: null,\n
\n
                    isLoading:false,\n
\n
                    displayTax: {\n
                        prices: "excluding_tax",\n
                        subtotal: "excluding_tax",\n
                    },\n
                }\n
