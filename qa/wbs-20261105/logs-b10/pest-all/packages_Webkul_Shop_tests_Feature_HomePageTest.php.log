        app.component("v-carousel", {\n
            template: '#v-carousel-template',\n
\n
            props: ['images'],\n
\n
            data() {\n
                return {\n
                    isDragging: false,\n
                    startPos: 0,\n
                    currentTranslate: 0,\n
                    prevTranslate: 0,\n
                    animationID: 0,\n
                    currentIndex: 0,\n
                    slider: '',\n
                    slides: [],\n
                    autoPlayInterval: null,\n
                    direction: 'ltr',\n
                    startFrom: 1,\n
                };\n
            },\n
\n
            mounted() {\n
                this.slider = this.$refs.sliderContainer;\n
\n
                if (\n
                    this.$refs.slide\n
                    && typeof this.$refs.slide[Symbol.iterator] === 'function'\n
                ) {\n
                    this.slides = Array.from(this.$refs.slide);\n
                }\n
\n
                // Use requestIdleCallback for non-critical initialization\n
                if ('requestIdleCallback' in window) {\n
                    requestIdleCallback(() => {\n
                        this.init();\n
                        setTimeout(() => {\n
                            this.play();\n
                        }, 4000);\n
                    });\n
                } else {\n
                    setTimeout(() => {\n
                        this.init();\n
                        setTimeout(() => {\n
                            this.play();\n
                        }, 4000);\n
                    });\n
                }\n
            },\n
\n
            beforeUnmount() {\n
                this.cleanup();\n
            },\n
\n
            methods: {\n
                init() {\n
                    this.direction = document.dir;\n
\n
                    if (this.direction == 'rtl') {\n
                        this.startFrom = -1;\n
                    }\n
\n
                    this.slides.forEach((slide, index) => {\n
                        slide.querySelector('img')?.addEventListener('dragstart', (e) => e.preventDefault());\n
\n
                        slide.addEventListener('mousedown', this.handleDragStart);\n
\n
                        slide.addEventListener('touchstart', this.handleDragStart, { passive: true });\n
\n
                        slide.addEventListener('mouseup', this.handleDragEnd);\n
\n
                        slide.addEventListener('mouseleave', this.handleDragEnd);\n
\n
                        slide.addEventListener('touchend', this.handleDragEnd, { passive: true });\n
\n
                        slide.addEventListener('mousemove', this.handleDrag);\n
\n
                        slide.addEventListener('touchmove', this.handleDrag, { passive: true });\n
                    });\n
\n
                    window.addEventListener('resize', this.setPositionByIndex);\n
                },\n
\n
                handleDragStart(event) {\n
                    this.startPos = event.type === 'mousedown' ? event.clientX : event.touches[0].clientX;\n
\n
                    this.isDragging = true;\n
\n
                    this.animationID = requestAnimationFrame(this.animation);\n
                },\n
\n
                handleDrag(event) {\n
                    if (! this.isDragging) {\n
                        return;\n
                    }\n
\n
                    const currentPosition = event.type === 'mousemove' ? event.clientX : event.touches[0].clientX;\n
\n
                    this.currentTranslate = this.prevTranslate + currentPosition - this.startPos;\n
                },\n
\n
                handleDragEnd(event) {\n
                    clearInterval(this.autoPlayInterval);\n
\n
                    cancelAnimationFrame(this.animationID);\n
\n
                    this.isDragging = false;\n
\n
                    const movedBy = this.currentTranslate - this.prevTranslate;\n
\n
                    if (this.direction == 'ltr') {\n
                        if (\n
                            movedBy < -100\n
                            && this.currentIndex < this.slides.length - 1\n
                        ) {\n
                            this.currentIndex += 1;\n
                        }\n
\n
                        if (\n
                            movedBy > 100\n
                            && this.currentIndex > 0\n
                        ) {\n
                            this.currentIndex -= 1;\n
                        }\n
                    } else {\n
                        if (\n
                            movedBy > 100\n
                            && this.currentIndex < this.slides.length - 1\n
                        ) {\n
                            if (Math.abs(this.currentIndex) != this.slides.length - 1) {\n
                                this.currentIndex -= 1;\n
                            }\n
                        }\n
\n
                        if (\n
                            movedBy < -100\n
                            && this.currentIndex < 0\n
                        ) {\n
                            this.currentIndex += 1;\n
                        }\n
                    }\n
\n
                    this.setPositionByIndex();\n
\n
                    this.play();\n
                },\n
\n
                animation() {\n
                    this.setSliderPosition();\n
\n
                    if (this.isDragging) {\n
                        requestAnimationFrame(this.animation);\n
                    }\n
                },\n
\n
                setPositionByIndex() {\n
                    this.currentTranslate = this.currentIndex * -window.innerWidth;\n
\n
                    this.prevTranslate = this.currentTranslate;\n
\n
                    this.setSliderPosition();\n
                },\n
\n
                setSliderPosition() {\n
                    if (this.slider) {\n
                        this.slider.style.transform = `translateX(${this.currentTranslate}px)`;\n
                    }\n
                },\n
\n
                visitLink(image) {\n
                    if (image.link) {\n
                        window.location.href = image.link;\n
                    }\n
                },\n
\n
                navigate(type) {\n
                    clearInterval(this.autoPlayInterval);\n
\n
                    if (this.direction === 'rtl') {\n
                        type === 'next' ? this.prev() : this.next();\n
                    } else {\n
                        type === 'next' ? this.next() : this.prev();\n
                    }\n
\n
                    this.setPositionByIndex();\n
\n
                    this.play();\n
                },\n
\n
                next() {\n
                    this.currentIndex = (this.currentIndex + this.startFrom) % this.images.length;\n
                },\n
\n
                prev() {\n
                    this.currentIndex = this.direction == 'ltr'\n
                        ? this.currentIndex > 0 ? this.currentIndex - 1 : 0\n
                        : this.currentIndex < 0 ? this.currentIndex + 1 : 0;\n
                },\n
\n
                navigateByPagination(index) {\n
                    this.direction == 'rtl' ? index = -index : '';\n
\n
                    clearInterval(this.autoPlayInterval);\n
\n
                    this.currentIndex = index;\n
\n
                    this.setPositionByIndex();\n
\n
                    this.play();\n
                },\n
\n
                play() {\n
                    clearInterval(this.autoPlayInterval);\n
\n
                    this.autoPlayInterval = setInterval(() => {\n
                        this.currentIndex = (this.currentIndex + this.startFrom) % this.images.length;\n
\n
                        this.setPositionByIndex();\n
                    }, 5000);\n
                },\n
\n
                cleanup() {\n
                    // Clear intervals and animation frames\n
                    clearInterval(this.autoPlayInterval);\n
                    cancelAnimationFrame(this.animationID);\n
\n
                    // Remove event listeners\n
                    if (this.slides) {\n
                        this.slides.forEach(slide => {\n
                            slide.removeEventListener('mousedown', this.handleDragStart);\n
                            slide.removeEventListener('touchstart', this.handleDragStart);\n
                            slide.removeEventListener('mouseup', this.handleDragEnd);\n
                            slide.removeEventListener('mouseleave', this.handleDragEnd);\n
                            slide.removeEventListener('touchend', this.handleDragEnd);\n
                            slide.removeEventListener('mousemove', this.handleDrag);\n
                            slide.removeEventListener('touchmove', this.handleDrag);\n
                        });\n
                    }\n
\n
                    window.removeEventListener('resize', this.setPositionByIndex);\n
                },\n
            },\n
        });\n
