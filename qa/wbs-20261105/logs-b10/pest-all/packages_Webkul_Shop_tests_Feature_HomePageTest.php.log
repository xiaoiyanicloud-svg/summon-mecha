            template: '#v-drawer-template',\n
\n
            props: [\n
                'isActive',\n
                'position',\n
                'width'\n
            ],\n
\n
            data() {\n
                return {\n
                    isOpen: this.isActive,\n
                };\n
            },\n
\n
            watch: {\n
                isActive: function(newVal, oldVal) {\n
                    this.isOpen = newVal;\n
                }\n
            },\n
\n
            computed: {\n
                enterFromLeaveToClasses() {\n
                    if (this.position == 'top') {\n
                        return '-translate-y-full';\n
                    } else if (this.position == 'bottom') {\n
                        return 'translate-y-full';\n
                    } else if (this.position == 'left') {\n
                        return 'ltr:-translate-x-full rtl:translate-x-full';\n
                    } else if (this.position == 'right') {\n
                        return 'ltr:translate-x-full rtl:-translate-x-full';\n
                    }\n
                }\n
            },\n
\n
            methods: {\n
                toggle() {\n
                    this.isOpen = ! this.isOpen;\n
\n
                    if (this.isOpen) {\n
                        document.body.style.overflow = 'hidden';\n
                    } else {\n
                        document.body.style.overflow ='auto';\n
                    }\n
\n
                    document.body.style.paddingRight = '';\n
\n
                    this.$emit('toggle', { isActive: this.isOpen });\n
                },\n
\n
                open() {\n
                    this.isOpen = true;\n
\n
                    const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;\n
\n
                    document.body.style.overflow = 'hidden';\n
\n
                    document.body.style.paddingRight = `${scrollbarWidth}px`;\n
\n
                    this.$emit('open', { isActive: this.isOpen });\n
                },\n
\n
                close() {\n
                    this.isOpen = false;\n
\n
                    document.body.style.overflow = 'auto';\n
\n
                    document.body.style.paddingRight = '';\n
\n
                    this.$emit('close', { isActive: this.isOpen });\n
                }\n
            },\n
        });\n
