        app.component('v-desktop-category', {\n
            template: '#v-desktop-category-template',\n
\n
            data() {\n
                return {\n
                    isLoading: true,\n
                    categories: [],\n
                    isDrawerActive: false,\n
                    currentViewLevel: 'main',\n
                    currentSecondLevelCategory: null,\n
                    currentParentCategory: null\n
                }\n
            },\n
\n
            mounted() {\n
                this.initCategories();\n
            },\n
\n
            methods: {\n
                initCategories() {\n
                    try {\n
                        const stored = localStorage.getItem('categories');\n
\n
                        if (stored) {\n
                            this.categories = JSON.parse(stored);\n
                            this.isLoading = false;\n
\n
                            return;\n
                        }\n
\n
                    } catch (e) {}\n
\n
                    this.getCategories();\n
                },\n
\n
                getCategories() {\n
                    this.$axios.get("http://localhost/api/categories/tree")\n
                        .then(response => {\n
                            this.isLoading = false;\n
                            this.categories = response.data.data;\n
                            localStorage.setItem('categories', JSON.stringify(this.categories));\n
                        })\n
                        .catch(error => {\n
                            console.log(error);\n
                        });\n
                },\n
\n
                pairCategoryChildren(category) {\n
                    if (! category.children) return [];\n
\n
                    return category.children.reduce((result, value, index, array) => {\n
                        if (index % 2 === 0) {\n
                            result.push(array.slice(index, index + 2));\n
                        }\n
                        return result;\n
                    }, []);\n
                },\n
\n
                toggleCategoryDrawer() {\n
                    this.isDrawerActive = !this.isDrawerActive;\n
                    if (this.isDrawerActive) {\n
                        this.currentViewLevel = 'main';\n
                    }\n
                },\n
\n
                onDrawerToggle(event) {\n
                    this.isDrawerActive = event.isActive;\n
                },\n
\n
                onDrawerClose(event) {\n
                    this.isDrawerActive = false;\n
                },\n
\n
                showThirdLevel(secondLevelCategory, parentCategory, event) {\n
                    if (secondLevelCategory.children && secondLevelCategory.children.length) {\n
                        this.currentSecondLevelCategory = secondLevelCategory;\n
                        this.currentParentCategory = parentCategory;\n
                        this.currentViewLevel = 'third';\n
\n
                        if (event) {\n
                            event.preventDefault();\n
                            event.stopPropagation();\n
                        }\n
                    }\n
                },\n
\n
                goBackToMainView() {\n
                    this.currentViewLevel = 'main';\n
                }\n
            },\n
        });\n
