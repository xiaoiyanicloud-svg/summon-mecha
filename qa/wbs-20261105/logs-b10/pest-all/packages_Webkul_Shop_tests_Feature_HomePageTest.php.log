        app.component('v-flash-group', {\n
            template: '#v-flash-group-template',\n
\n
            data() {\n
                return {\n
                    uid: 0,\n
\n
                    flashes: []\n
                }\n
            },\n
\n
            created() {\n
                this.loadInitialFlashes();\n
\n
                this.registerGlobalEvents();\n
            },\n
\n
            methods: {\n
                loadInitialFlashes() {\n
                                            let flashes = [];\n
                    \n
                    if (typeof(flashes) === 'string') {\n
                        return;\n
                    }\n
                    \n
                    flashes.forEach(flash => {\n
                        flash.uid = this.uid++;\n
\n
                        this.flashes.push(flash);\n
                    });\n
                },\n
\n
                add(flash) {\n
                    flash.uid = this.uid++;\n
\n
                    this.flashes.push(flash);\n
                },\n
\n
                remove(flash) {\n
                    let index = this.flashes.indexOf(flash);\n
\n
                    this.flashes.splice(index, 1);\n
                },\n
\n
                registerGlobalEvents() {\n
                    this.$emitter.on('add-flash', this.add);\n
                },\n
            }\n
        });\n
