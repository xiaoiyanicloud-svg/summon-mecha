                    entries.forEach(function(entry) {\n
                        if (entry.isIntersecting) {\n
                            let lazyImage = document.getElementById('image-' + self.$.uid);\n
\n
                            lazyImage.src = lazyImage.dataset.src;\n
\n
                            lazyImageObserver.unobserve(lazyImage);\n
                        }\n
                    });\n
                });\n
\n
                lazyImageObserver.observe(document.getElementById('image-shimmer-' + this.$.uid));\n
            },\n
\n
            methods: {\n
                onLoad() {\n
                    this.isLoading = false;\n
                },\n
            },\n
        });\n
