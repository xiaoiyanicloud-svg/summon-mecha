<?xml version="1.0" encoding="utf-8"?>
<robot name="unitree_g1_23dof">
  <!-- Adjacent link collision disable matrix -->
  <disable_collisions link1="pelvis" link2="torso_link" reason="Adjacent"/>
  <disable_collisions link1="torso_link" link2="head_link" reason="Adjacent"/>
  <disable_collisions link1="torso_link" link2="right_shoulder_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="right_shoulder_pitch_link" link2="right_shoulder_roll_link" reason="Adjacent"/>
  <disable_collisions link1="right_shoulder_roll_link" link2="right_shoulder_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="right_shoulder_yaw_link" link2="right_elbow_link" reason="Adjacent"/>
  <disable_collisions link1="right_elbow_link" link2="right_wrist_roll_link" reason="Adjacent"/>
  <disable_collisions link1="right_wrist_roll_link" link2="right_palm_link" reason="Adjacent"/>

  <disable_collisions link1="torso_link" link2="left_shoulder_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_pitch_link" link2="left_shoulder_roll_link" reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_roll_link" link2="left_elbow_link" reason="Adjacent"/>

  <disable_collisions link1="pelvis" link2="right_hip_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="right_hip_pitch_link" link2="right_knee_link" reason="Adjacent"/>
  <disable_collisions link1="right_knee_link" link2="right_foot_link" reason="Adjacent"/>

  <disable_collisions link1="pelvis" link2="left_hip_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="left_hip_pitch_link" link2="left_knee_link" reason="Adjacent"/>
  <disable_collisions link1="left_knee_link" link2="left_foot_link" reason="Adjacent"/>

  <!-- Non-adjacent naturally separated links -->
  <disable_collisions link1="head_link" link2="right_palm_link" reason="NeverInContactUnderNormalLimits"/>
  <disable_collisions link1="pelvis" link2="right_palm_link" reason="NeverInContactUnderNormalLimits"/>
</robot>
