    </visual>
    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.26 0.36"/>
      </geometry>
    </collision>
  </link>

  <joint name="waist_yaw_joint" type="revolute">
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <parent link="pelvis"/>
    <child link="torso_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="60.0" velocity="4.0"/>
  </joint>

  <!-- Head -->
  <link name="head_link">
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="1.20"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.004"/>
