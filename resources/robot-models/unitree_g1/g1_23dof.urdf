<?xml version="1.0" encoding="utf-8"?>
<robot name="unitree_g1_23dof">
  <!-- Pelvis (Base) -->
  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.50"/>
      <inertia ixx="0.025" ixy="0.0" ixz="0.0" iyy="0.020" iyz="0.0" izz="0.018"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.22 0.12"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.22 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Torso -->
  <link name="torso_link">
    <inertial>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <mass value="9.80"/>
      <inertia ixx="0.095" ixy="0.0" ixz="0.0" iyy="0.082" iyz="0.0" izz="0.045"/>
