<mujoco model="unitree_g1_23dof">
  <compiler angle="radian" coordinate="local" meshdir="" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" iterations="50" solver="Newton">
    <flag contact="enable" energy="enable"/>
  </option>

  <default>
    <joint damping="0.8" armature="0.01" frictionloss="0.1"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.1 0.1"/>
    <position kp="150" kv="12"/>
  </default>

  <worldbody>
    <light directional="true" pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- Pelvis Base -->
    <body name="pelvis" pos="0 0 0.75">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="4.5" diaginertia="0.025 0.020 0.018"/>
      <geom name="pelvis_geom" type="box" size="0.09 0.11 0.06" rgba="0.2 0.2 0.2 1"/>

      <!-- Torso -->
      <body name="torso_link" pos="0 0 0.08">
        <joint name="waist_yaw_joint" type="hinge" axis="0 0 1" range="-2.618 2.618"/>
        <inertial pos="0 0 0.18" mass="9.8" diaginertia="0.095 0.082 0.045"/>
        <geom name="torso_geom" type="box" size="0.10 0.13 0.18" pos="0 0 0.18" rgba="0.7 0.7 0.7 1"/>

        <!-- Head -->
        <body name="head_link" pos="0 0 0.38">
          <joint name="neck_pitch_joint" type="hinge" axis="0 1 0" range="-0.523 0.523"/>
          <inertial pos="0 0 0.08" mass="1.2" diaginertia="0.005 0.005 0.004"/>
          <geom name="head_geom" type="sphere" size="0.09" pos="0 0 0.08" rgba="0.2 0.8 0.9 1"/>
        </body>

        <!-- Right Arm (Wave Arm) -->
        <body name="right_shoulder_pitch_link" pos="0 -0.16 0.30">
          <joint name="right_shoulder_pitch_joint" type="hinge" axis="0 1 0" range="-3.0892 2.6704"/>
          <inertial pos="0 0 0" mass="0.75" diaginertia="0.001 0.001 0.001"/>
          <geom name="r_sp_geom" type="cylinder" size="0.04 0.04" rgba="0.3 0.3 0.3 1"/>

          <body name="right_shoulder_roll_link" pos="0 0 0">
            <joint name="right_shoulder_roll_joint" type="hinge" axis="1 0 0" range="-2.2515 1.5882"/>
            <inertial pos="0 -0.05 0" mass="0.82" diaginertia="0.0015 0.0012 0.0015"/>
            <geom name="r_sr_geom" type="cylinder" size="0.035 0.05" pos="0 -0.05 0" rgba="0.1 0.7 0.3 1"/>

            <body name="right_shoulder_yaw_link" pos="0 -0.08 0">
              <joint name="right_shoulder_yaw_joint" type="hinge" axis="0 0 1" range="-2.618 2.618"/>
              <inertial pos="0 0 -0.06" mass="0.65" diaginertia="0.001 0.001 0.0008"/>
              <geom name="r_sy_geom" type="cylinder" size="0.03 0.06" pos="0 0 -0.06" rgba="0.3 0.3 0.3 1"/>

              <body name="right_elbow_link" pos="0 0 -0.12">
                <joint name="right_elbow_joint" type="hinge" axis="0 1 0" range="-1.0472 2.0944"/>
                <inertial pos="0 0 -0.08" mass="0.70" diaginertia="0.0018 0.0018 0.0006"/>
                <geom name="r_el_geom" type="cylinder" size="0.028 0.08" pos="0 0 -0.08" rgba="0.1 0.7 0.3 1"/>

                <body name="right_palm_link" pos="0 0 -0.16">
                  <inertial pos="0 0 -0.04" mass="0.3" diaginertia="0.0003 0.0003 0.0002"/>
                  <geom name="r_palm_geom" type="box" size="0.02 0.04 0.05" pos="0 0 -0.04" rgba="0.2 0.2 0.2 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>

        <!-- Left Arm -->
        <body name="left_shoulder_pitch_link" pos="0 0.16 0.30">
          <joint name="left_shoulder_pitch_joint" type="hinge" axis="0 1 0" range="-3.0892 2.6704"/>
          <inertial pos="0 0 0" mass="0.75" diaginertia="0.001 0.001 0.001"/>
          <geom name="l_sp_geom" type="cylinder" size="0.04 0.04" rgba="0.3 0.3 0.3 1"/>

          <body name="left_shoulder_roll_link" pos="0 0 0">
            <joint name="left_shoulder_roll_joint" type="hinge" axis="1 0 0" range="-1.5882 2.2515"/>
            <inertial pos="0 0.05 0" mass="0.82" diaginertia="0.0015 0.0012 0.0015"/>
            <geom name="l_sr_geom" type="cylinder" size="0.035 0.05" pos="0 0.05 0" rgba="0.3 0.3 0.3 1"/>

            <body name="left_elbow_link" pos="0 0.08 -0.12">
              <joint name="left_elbow_joint" type="hinge" axis="0 1 0" range="-1.0472 2.0944"/>
              <inertial pos="0 0 -0.08" mass="0.70" diaginertia="0.0018 0.0018 0.0006"/>
              <geom name="l_el_geom" type="cylinder" size="0.028 0.08" pos="0 0 -0.08" rgba="0.3 0.3 0.3 1"/>
            </body>
          </body>
        </body>

      </body>

      <!-- Legs (Standing Base for Stability Check) -->
      <body name="right_hip_pitch_link" pos="0 -0.08 -0.05">
        <joint name="right_hip_pitch_joint" type="hinge" axis="0 1 0" range="-2.0 1.5"/>
        <inertial pos="0 0 -0.15" mass="3.5" diaginertia="0.03 0.03 0.006"/>
        <geom name="r_hip_geom" type="cylinder" size="0.045 0.15" pos="0 0 -0.15" rgba="0.3 0.3 0.3 1"/>

        <body name="right_knee_link" pos="0 0 -0.30">
          <joint name="right_knee_joint" type="hinge" axis="0 1 0" range="-0.1 2.4"/>
          <inertial pos="0 0 -0.15" mass="2.8" diaginertia="0.025 0.025 0.004"/>
          <geom name="r_knee_geom" type="cylinder" size="0.04 0.15" pos="0 0 -0.15" rgba="0.3 0.3 0.3 1"/>

          <body name="right_foot_link" pos="0 0 -0.30">
            <joint name="right_ankle_joint" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <inertial pos="0.04 0 -0.02" mass="0.85" diaginertia="0.002 0.005 0.005"/>
            <geom name="r_foot_geom" type="box" size="0.10 0.04 0.02" pos="0.04 0 -0.02" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>

      <body name="left_hip_pitch_link" pos="0 0.08 -0.05">
        <joint name="left_hip_pitch_joint" type="hinge" axis="0 1 0" range="-2.0 1.5"/>
        <inertial pos="0 0 -0.15" mass="3.5" diaginertia="0.03 0.03 0.006"/>
        <geom name="l_hip_geom" type="cylinder" size="0.045 0.15" pos="0 0 -0.15" rgba="0.3 0.3 0.3 1"/>

        <body name="left_knee_link" pos="0 0 -0.30">
          <joint name="left_knee_joint" type="hinge" axis="0 1 0" range="-0.1 2.4"/>
          <inertial pos="0 0 -0.15" mass="2.8" diaginertia="0.025 0.025 0.004"/>
          <geom name="l_knee_geom" type="cylinder" size="0.04 0.15" pos="0 0 -0.15" rgba="0.3 0.3 0.3 1"/>

          <body name="left_foot_link" pos="0 0 -0.30">
            <joint name="left_ankle_joint" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <inertial pos="0.04 0 -0.02" mass="0.85" diaginertia="0.002 0.005 0.005"/>
            <geom name="l_foot_geom" type="box" size="0.10 0.04 0.02" pos="0.04 0 -0.02" rgba="0.1 0.1 0.1 1"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- Actuators: Joint Position Controllers -->
  <actuator>
    <position name="act_waist_yaw" joint="waist_yaw_joint" kp="200" kv="15"/>
    <position name="act_r_sp" joint="right_shoulder_pitch_joint" kp="150" kv="10"/>
    <position name="act_r_sr" joint="right_shoulder_roll_joint" kp="260" kv="12"/>
    <position name="act_r_sy" joint="right_shoulder_yaw_joint" kp="100" kv="8"/>
    <position name="act_r_el" joint="right_elbow_joint" kp="150" kv="10"/>
    <position name="act_l_sp" joint="left_shoulder_pitch_joint" kp="150" kv="10"/>
    <position name="act_l_sr" joint="left_shoulder_roll_joint" kp="150" kv="10"/>
    <position name="act_l_el" joint="left_elbow_joint" kp="120" kv="8"/>
    <position name="act_r_hip" joint="right_hip_pitch_joint" kp="300" kv="25"/>
    <position name="act_r_knee" joint="right_knee_joint" kp="300" kv="25"/>
    <position name="act_r_ankle" joint="right_ankle_joint" kp="200" kv="15"/>
    <position name="act_l_hip" joint="left_hip_pitch_joint" kp="300" kv="25"/>
    <position name="act_l_knee" joint="left_knee_joint" kp="300" kv="25"/>
    <position name="act_l_ankle" joint="left_ankle_joint" kp="200" kv="15"/>
  </actuator>
</mujoco>
