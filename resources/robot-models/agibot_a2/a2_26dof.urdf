<?xml version="1.0" encoding="utf-8"?>
<robot name="agibot_a2_26dof">
  <!-- Agibot A2 Humanoid Ground Truth URDF (26 Degrees of Freedom) -->

  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.085" ixy="0" ixz="0" iyy="0.075" iyz="0" izz="0.065"/>
    </inertial>
    <visual>
      <geometry><box size="0.22 0.26 0.16"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.22 0.26 0.16"/></geometry>
    </collision>
  </link>

  <!-- Waist Yaw Joint & Link -->
  <joint name="waist_yaw_joint" type="revolute">
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <parent link="pelvis"/>
    <child link="waist_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="60.0" velocity="3.14"/>
  </joint>
  <link name="waist_yaw_link">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.010"/>
