    <visual><geometry><cylinder radius="0.09" length="0.08"/></geometry></visual>
    <collision><geometry><cylinder radius="0.09" length="0.08"/></geometry></collision>
  </link>

  <!-- Torso Link -->
  <joint name="waist_pitch_joint" type="revolute">
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
